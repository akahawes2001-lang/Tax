# ============================================
# TaxBel — конфигурация окружения
# Скопируйте в docker-compose.yml уровня или
# в tax-api/.env для разработки
# ============================================

# --- База данных (для docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=tax_calculator

# --- База данных (для разработки без Docker) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tax_calculator

# --- JWT ---
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,https://taxbel.by

# --- reCAPTCHA v2 ---
RECAPTCHA_SITE_KEY=ваш-recaptcha-site-key
RECAPTCHA_SECRET_KEY=ваш-recaptcha-secret-key

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# --- Sentry (мониторинг ошибок) ---
SENTRY_DSN=

# --- Окружение ---
ENVIRONMENT=development